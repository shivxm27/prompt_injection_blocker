{
  "manifest_version": 3,
  "name": "Prompt Injection Blocker",
  "version": "1.0.0",
  "description": "Detects and silently strips prompt injection attacks from copied text on Coursera.",
  "permissions": ["clipboardRead", "clipboardWrite", "storage"],
  "host_permissions": ["https://www.coursera.org/*"],
  "content_scripts": [
    {
      "matches": ["https://www.coursera.org/*"],
      "js": ["patterns/injectionPatterns.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
